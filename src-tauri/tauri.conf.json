{
  "productName": "Hashcat Studio",
  "version": "0.1.0",
  "identifier": "com.hashcat.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hashcat Studio",
        "width": 1440,
        "height": 1080,
        "resizable": true,
        "dragDropEnabled": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "resources": {"target/release/WebView2Loader.dll": "WebView2Loader.dll"},
    "publisher": "Hashcat Studio contributors",
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 Hashcat Studio contributors",
    "licenseFile": "../LICENSE",
    "shortDescription": "Learning-first desktop UI for hashcat",
    "longDescription": "A local, offline desktop interface for configuring, monitoring and learning hashcat without reimplementing its algorithms."
  }
}
